{
  "name": "dsh-local-plugin-manager",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoliang233/dsh-plugins.git",
    "directory": "dsh-local-plugin-manager"
  },
  "homepage": "https://github.com/zhaoliang233/dsh-plugins/tree/main/dsh-local-plugin-manager#readme",
  "bugs": "https://github.com/zhaoliang233/dsh-plugins/issues",
  "description": "在「设置 > 插件 > 本地插件」中列出、启停或卸载当前 web profile 的本地 link 插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dshCompatibility": {
    "policy": "compatible-release-line",
    "package": "@deepseek-ai/dsh",
    "range": ">=0.1.6-alpha.1 <0.1.7",
    "verifiedVersions": [
      "0.1.6-alpha.1"
    ],
    "futureVersionsRequireCapabilityChecks": true
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/profile-manager.js && node --check client.js && bash -n install.sh && bash -n uninstall.sh",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6-alpha.1 <0.1.7"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  },
  "private": true,
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "local-plugin",
    "plugin-manager"
  ]
}
