{
  "name": "dsh-local-plugin-manager",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoliang233/dsh-plugins.git",
    "directory": "dsh-local-plugin-manager"
  },
  "homepage": "https://github.com/zhaoliang233/dsh-plugins/tree/main/dsh-local-plugin-manager#readme",
  "bugs": "https://github.com/zhaoliang233/dsh-plugins/issues",
  "description": "面向插件开发者：在「设置 > 插件开发」里管理当前 web profile 中以 link: 挂载的本地源码插件，查看源路径与 loader 行，并快速启停或移除。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "dshCompatibility": {
    "policy": "compatible-release-line",
    "package": "@deepseek-ai/dsh",
    "range": ">=0.1.7-alpha.1 <0.1.8",
    "verifiedVersions": [
      "0.1.7-alpha.1",
      "0.1.7-alpha.2"
    ],
    "futureVersionsRequireCapabilityChecks": true
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/profile-manager.js && node --check lib/patch-writer.js && node --check lib/errors.js && node --check client.js && node --check scripts/gui-check.mjs && bash -n install.sh && bash -n uninstall.sh",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm test",
    "gui:check": "node scripts/gui-check.mjs",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-alpha.1 <0.1.8"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "~0.1.7-alpha.1",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin-development",
    "local-plugin",
    "link-plugin"
  ]
}
